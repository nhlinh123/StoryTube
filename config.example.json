  "render": {
    "fps": 30,
    "crf": 20,
    "preset": "medium",
    "pix_fmt": "yuv420p",
    "audio_bitrate": "192k",
    "sample_rate": 48000,
    "scene_gap_ms": 260,
    "min_scene_ms": 1800,
    "tail_ms": 380,
    "bgm_gain": 0.14,
    "loudness": {
      "I": -14.0,
      "TP": -1.5,
      "LRA": 11.0
    },
    "fontsdir": "C:\\Windows\\Fonts",
    "ratios": {
      "9:16": {
        "w": 1080,
        "h": 1920,
        "label": "TikTok / Reels / Shorts",
        "safe": {
          "top": 150,
          "bottom": 420,
          "side": 96
        }
      },
      "4:5": {
