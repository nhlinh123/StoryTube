      "elevenlabs",
      "pollinations"
    ],
    "model": "gemini-3.1-flash-image",
    "aspect_ratio": "9:16",
    "resolution": "2K",
    "style_suffix": "cinematic film still, 35mm, shallow depth of field, volumetric light, moody color grade, subtle film grain, Vietnamese setting, no text, no watermark",
    "providers": {
      "elevenlabs": {
        "label": "ElevenLabs Image (Flows)",
        "base_url": "https://api.elevenlabs.io/v1",
        "api_key": "",
